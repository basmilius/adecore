{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["packages/*/dist/**", "docs/.vitepress/cache/**", "docs/.vitepress/dist/**"],
  "rules": {
    "curly": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Only says the React Compiler skipped a component, which outside the packages it builds says nothing.
    "react/preserve-manual-memoization": "off"
  },
  "overrides": [
    {
      // The packages whose build runs the React Compiler, held to the Rules of React it relies on. Its `todo`
      // (syntax it cannot compile yet) and `rule-suppression` (a dependency list left short on purpose) are no faults.
      "files": ["packages/ui/src/**", "packages/agents-react/src/**", "packages/editor-react/src/**", "packages/terminal/src/**", "packages/charts/src/**"],
      "rules": {
        "react/hooks": "error",
        "react/refs": "error",
        "react/purity": "error",
        "react/immutability": "error",
        "react/globals": "error",
        "react/set-state-in-render": "error",
        "react/set-state-in-effect": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/void-use-memo": "error",
        "react/unsupported-syntax": "error",
        "react/incompatible-library": "error",
        "react/error-boundaries": "error",
        "react/preserve-manual-memoization": "error"
      }
    },
    {
      // The one module that calls the hooks a host hands in, which its provider pins.
      "files": ["packages/agents-react/src/host/host-hooks.ts"],
      "rules": {
        "react/hooks": "off"
      }
    }
  ]
}

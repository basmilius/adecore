{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vitepress/client",
      "bun"
    ],
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "demos",
    "*.ts",
    "*.tsx",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.tsx"
  ],
  "exclude": [
    ".vitepress/cache",
    ".vitepress/dist"
  ]
}

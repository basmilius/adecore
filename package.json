{
  "name": "basmilius-desktop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "oxlint --deny-warnings",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "format": "oxfmt --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}

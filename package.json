{
  "name": "@basmilius/react-ui",
  "version": "0.0.0",
  "description": "React components, a theme, formatters and a settings dialog for desktop-grade apps on React 19, Base UI and Tailwind 4.",
  "license": "MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/react-ui.git"
  },
  "bugs": {
    "url": "https://github.com/basmilius/react-ui/issues"
  },
  "homepage": "https://react-ui.bas.dev",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "packageManager": "bun@1.4.0",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "source": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./format": {
      "source": "./src/format/index.ts",
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./theme.css": {
      "source": "./src/theme.css",
      "style": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@pierre/trees": "1.0.0-beta.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "^26.4.2",
    "oxc-parser": "^0.151.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2"
  }
}

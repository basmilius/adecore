{
  "name": "adecore",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.scripts.json && bun run --filter './packages/*' typecheck",
    "lint": "oxlint --deny-warnings && bun scripts/check-design-conventions.ts",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "test:perf": "bun --config=perf.bunfig.toml test .perf.test.ts",
    "test:helper": "bun --config=helper.bunfig.toml test ./packages/database/src/helper.integration.test.ts",
    "format": "oxfmt --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"docs/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "pack": "bun scripts/pack-packages.ts",
    "test:pack": "bun scripts/validate-packages.ts",
    "release:version": "bun scripts/release.ts version",
    "release:order": "bun scripts/release.ts order",
    "release:publish": "bun scripts/release.ts publish"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "i18next": "^26.5.11",
    "oxc-parser": "^0.151.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "typescript": "^7.0.2"
  }
}

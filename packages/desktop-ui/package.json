{
  "name": "@basmilius/desktop-ui",
  "version": "0.0.0",
  "description": "React components, a theme, formatters and a settings dialog for desktop-grade apps on React 19, Base UI and Tailwind 4.",
  "license": "MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/desktop.git",
    "directory": "packages/desktop-ui"
  },
  "bugs": {
    "url": "https://github.com/basmilius/desktop/issues"
  },
  "homepage": "https://desktop.bas.dev/desktop-ui/",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/testing/dedupe.ts",
    "./dist/testing/dedupe.js"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "source": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./format": {
      "source": "./src/format/index.ts",
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./terminal": {
      "source": "./src/terminal/index.ts",
      "types": "./dist/terminal/index.d.ts",
      "default": "./dist/terminal/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/dedupe": {
      "source": "./src/testing/dedupe.ts",
      "types": "./dist/testing/dedupe.d.ts",
      "default": "./dist/testing/dedupe.js"
    },
    "./theme.css": {
      "source": "./src/theme.css",
      "style": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@pierre/trees": "1.0.0-beta.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/addon-webgl": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.4.2",
    "opentype.js": "2.0.0",
    "oxc-parser": "^0.151.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2"
  }
}

// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`scheduledTask the task of a packaged app 1`] = `
"<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Example worker</Description>
    <URI>\\Example Worker</URI>
    <Documentation>@echo off
chcp 65001 &gt;nul
cd /d C:\\Users\\bas || exit /b 1
set ^"WORKER_HOME=C:\\Users\\bas\\.worker^"
set ^"PATH=C:\\Program^ Files\\Git\\cmd^;C:\\Windows\\System32^"
^"C:\\Users\\bas\\AppData\\Local\\Programs\\Example\\resources\\bin\\worker.exe^" ^"--port^" ^"4210^" &gt;&gt;C:\\Users\\bas\\AppData\\Local\\Example\\logs\\daemon.log 2&gt;&amp;1
</Documentation>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP-1\\bas</UserId>
      <Repetition>
        <Interval>PT1M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP-1\\bas</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\\System32\\conhost.exe</Command>
      <Arguments>--headless cmd.exe /d /c .\\Example_Worker.cmd</Arguments>
      <WorkingDirectory>C:\\Users\\bas\\AppData\\Local\\Example\\service</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
"
`;

exports[`launchAgentPlist the LaunchAgent of a packaged app 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Example.app/Contents/Resources/bin/worker</string>
        <string>--port</string>
        <string>4210</string>
        <string>--serve</string>
        <string>/Applications/Example.app/Contents/Resources/client</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>WORKER_HOME</key>
        <string>/Users/bas/.worker</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/bas</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/bas/Library/Logs/Example/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bas/Library/Logs/Example/daemon.log</string>
</dict>
</plist>
"
`;

exports[`systemdUnit the user unit of a packaged app 1`] = `
"[Unit]
Description=Example worker

[Service]
Type=simple
ExecStart="/opt/Example/resources/bin/worker" "--port" "4210" "--serve" "/opt/Example/resources/client"
Environment="WORKER_HOME=/home/bas/.worker"
Environment="PATH=/home/bas/.local/bin:/usr/bin:/bin"
WorkingDirectory=/home/bas
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"
`;

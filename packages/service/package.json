{
  "name": "@adecore/service",
  "version": "0.0.0",
  "description": "User service definitions and injectable launchd, systemd and Task Scheduler managers.",
  "license": "FSL-1.1-MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/adecore.git",
    "directory": "packages/service"
  },
  "homepage": "https://adecore.dev/service/",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definitions": {
      "source": "./src/definitions.ts",
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    },
    "./manager": {
      "source": "./src/manager.ts",
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./platform": {
      "source": "./src/platform.ts",
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./system": {
      "source": "./src/system.ts",
      "types": "./dist/system.d.ts",
      "default": "./dist/system.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check --no-script",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

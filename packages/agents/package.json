{
    "name": "@adecore/agents",
    "version": "0.0.0",
    "description": "Node-compatible agent chat hosts, providers, accounts, usage and durable task coordination.",
    "type": "module",
    "exports": {
        "./*.json": {
            "source": "./src/*.json",
            "default": "./dist/*.json"
        },
        "./*": {
            "source": "./src/*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun scripts/build.ts",
        "test": "bun --conditions=source test"
    },
    "dependencies": {
        "@adecore/agent-contracts": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "typescript": "^7.0.2",
        "@types/node": "^26.6.3"
    },
    "license": "FSL-1.1-MIT",
    "author": "Bas Milius",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/basmilius/adecore.git",
        "directory": "packages/agents"
    },
    "bugs": {
        "url": "https://github.com/basmilius/adecore/issues"
    },
    "homepage": "https://adecore.dev/agents/",
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/__snapshots__"
    ],
    "sideEffects": false
}

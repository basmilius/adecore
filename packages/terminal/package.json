{
  "name": "@adecore/terminal",
  "version": "0.0.0",
  "private": true,
  "description": "A themed terminal pane on xterm.js that fits its container and is fed by the app.",
  "license": "MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/adecore.git",
    "directory": "packages/terminal"
  },
  "bugs": {
    "url": "https://github.com/basmilius/adecore/issues"
  },
  "homepage": "https://adecore.dev/terminal/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./terminal.css": {
      "source": "./src/terminal.css",
      "style": "./src/terminal.css",
      "default": "./dist/terminal.css"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
